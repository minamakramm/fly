# Fly Capstone Environment Configuration Template
# DO NOT COMMIT SECRETS OR REAL PRIVATE KEYS TO VERSION CONTROL

# Public Application URL (used for server-side health checks & metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public API Base Endpoint
NEXT_PUBLIC_API_BASE_URL=https://api.fly-capstone.example.com

# System Environment Mode
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_TELEMETRY=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Optional Vercel / Netlify Telemetry Secret Placeholder (DO NOT COMMIT REAL VALUES)
HEALTH_CHECK_SECRET_KEY=placeholder_health_secret_key_change_in_vercel_settings
